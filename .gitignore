.env
.env.local
.env.*.local

# Node/build artifacts
node_modules/
dist/
.supatype/engine/
.turbo
.next
.supatype

# Editor
.vscode/settings.json
.idea/
.cursor/skills/
.claude/skills/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
lcov.info

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
*.tsbuildinfo

# Release build output. Each compiled CLI binary is 80 to 130 MB, so an unignored run of
# build-release-artifacts.sh leaves the best part of a gigabyte in the working tree.
release-bundle/
artifacts/

# Local binary overrides, never commit
supatype.local.config.ts
supatype.local.config.js
supatype.local.config.mjs

# Generated by supatype push
src/types/supatype.d.ts
src/lib/supatype.ts

# Studio build output. The Docker image builds it in its own builder stage and
# dev runs Vite from source, so a committed copy is only ever stale: it shipped
# an outdated client field name once already.
packages/studio/dist-app/

# The generated seed builder. `supatype generate` writes it, it needs no database and no
# running stack, and the CLI puts this same line in every new project's .gitignore. An example
# that committed it would be doing the opposite of what the scaffold tells people to do.
# Anchored with `**/` because a pattern containing a slash is relative to the .gitignore that
# holds it, and this one sits at the monorepo root rather than in each example.
**/supatype/generated/seed.ts
