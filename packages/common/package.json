{
  "name": "@supatype/common",
  "version": "0.7.0",
  "license": "MIT",
  "description": "Shared auth, config, and analytics for Supatype web apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./analytics": {
      "import": "./dist/analytics.js",
      "types": "./dist/analytics.d.ts"
    },
    "./richtext": {
      "import": "./dist/richtext.js",
      "types": "./dist/richtext.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@supatype/client": "workspace:*",
    "@supatype/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
