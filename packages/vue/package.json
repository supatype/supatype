{
  "name": "@supatype/vue",
  "version": "0.1.5",
  "license": "MIT",
  "description": "Vue composables for Supatype, useQuery, useMutation, useAuth, useSubscription",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@supatype/client": "workspace:*",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@supatype/client": "workspace:*",
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vue": "^3.5.0"
  }
}
