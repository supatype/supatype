{
  "name": "@supatype/react",
  "version": "0.7.0",
  "license": "MIT",
  "description": "Supatype React hooks: useAuth, useQuery, useMutation, SupatypeProvider",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@supatype/client": "workspace:*",
    "@supatype/common": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-test-renderer": "^18",
    "react": "^18",
    "react-test-renderer": "^18",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
