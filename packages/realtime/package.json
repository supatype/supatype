{
  "name": "@supatype/realtime",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "description": "Supatype realtime service: WebSocket server with Postgres logical replication, presence, and broadcast",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@supatype/types": "workspace:*",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/ws": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
