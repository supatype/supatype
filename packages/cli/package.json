{
  "name": "@supatype/cli",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "description": "Supatype CLI: schema push, introspect, generate",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "supatype": "./bin/supatype.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/supatype.js",
    "dist",
    "!dist/**/supatype-eval-*",
    "!dist/**/*.tsbuildinfo",
    "releases",
    "deno.d.ts",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./deno": {
      "types": "./deno.d.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/release-images.mjs generate && node ../../scripts/functions-worker-source.mjs generate && node ../../scripts/typescript-libs.mjs generate && tsc --project tsconfig.json && node --input-type=module -e \"import{cpSync,mkdirSync}from'node:fs';const a='dist/assets';mkdirSync(a,{recursive:true});cpSync('assets/supatype-logo-wordmark.ascii.txt',a+'/supatype-logo-wordmark.ascii.txt')\"",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tests/tsconfig.json --noEmit && tsc --project bin/tsconfig.json",
    "typecheck:tests": "tsc --project tests/tsconfig.json --noEmit",
    "postinstall": "node --input-type=module --eval \"import{existsSync}from'node:fs';import{resolve}from'node:path';import{pathToFileURL}from'node:url';const f=resolve(process.cwd(),'dist/scripts/postinstall.js');if(existsSync(f))await import(pathToFileURL(f).href)\"",
    "test": "vitest run --maxWorkers=50%",
    "test:packed": "vitest run --config vitest.packed.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@supatype/shared": "workspace:*",
    "pg": "^8.13.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@supatype/types": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^18.3.18",
    "@types/semver": "7.7.1",
    "bcryptjs": "^3.0.2",
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "semver": "7.8.5",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "vitest": "^4.0.18"
  }
}
