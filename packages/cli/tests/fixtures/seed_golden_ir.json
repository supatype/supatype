            "valid_until": {
              "kind": "after",
              "base": {
                "kind": "now"
              },
              "interval": {
                "days": 25
              }
            },
            "event": {
              "connect": {
                "slug": "southwest-dev-conference"
              }
            }
          }
        }
      ]
    },
    {
      "op": "sql",
