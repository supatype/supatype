{
  "version": 2,
  "roles": ["owner", "admin", "developer", "editor", "billing", "viewer"],
  "selfHostRoles": ["admin", "developer", "editor", "viewer"],
  "notes": {
    "sqlEditor": "The SQL editor runs as the project's owning role, so row level security does not apply to it: whoever holds sqlEditor can read and change every row (owner decision RX1).",
    "elevatedSql": "Acting as the service role for data requests (the elevated mode), which only these roles may switch to."
  },
  "permissions": {
    "read": ["owner", "admin", "developer", "editor", "viewer"],
    "write": ["owner", "admin", "developer", "editor"],
    "schemaView": ["owner", "admin", "developer", "viewer"],
    "pushSchema": ["owner", "admin", "developer"],
    "deploy": ["owner", "admin", "developer"],
    "sqlEditor": ["owner", "admin", "developer"],
    "elevatedSql": ["owner", "admin"],
    "realtimeInspect": ["owner", "admin", "developer"],
    "viewLogs": ["owner", "admin", "developer", "viewer"],
    "manageKeys": ["owner", "admin"],
    "manageDomains": ["owner", "admin"],
    "manageMembers": ["owner", "admin"],
    "billing": ["owner", "admin", "billing"],
    "ownOrg": ["owner"],
    "orgSettings": ["owner", "admin"],
    "createProject": ["owner", "admin", "developer"],
    "deleteProject": ["owner", "admin"],
    "viewUsage": ["owner", "admin", "developer", "billing"]
  }
}
