{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "specs",
    "playwright.config.ts",
    "masking/lib",
    "masking/specs",
    "masking/*.ts",
    "masking/project/schema",
    "masking/project/supatype.config.ts",
    "positioning/specs",
    "positioning/*.ts"
  ]
}
