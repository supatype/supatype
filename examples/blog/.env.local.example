# Copy this to .env.local and fill in the values.
# README.md has the steps: build the repo, then run `pnpm exec supatype dev` in this folder.
NEXT_PUBLIC_SUPATYPE_URL=http://localhost:18473
NEXT_PUBLIC_SUPATYPE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPATYPE_AUTH_COOKIE_PREFIX=st
SUPATYPE_AUTH_COOKIE_PREFIX=st
# Read by the server on each request: the server client, and /supatype-env.js, which gives the
# browser client its values when the page loads. A build made without the NEXT_PUBLIC_ names runs
# with whichever pair `next start` is given here.
SUPATYPE_URL=http://localhost:18473
SUPATYPE_ANON_KEY=your-anon-key-here
