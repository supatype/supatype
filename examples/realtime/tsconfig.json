{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "schema",
    "supatype.config.ts",
    "verify.ts",
    "supatype/generated"
  ],
  "exclude": [
    "node_modules",
    "hooks"
  ]
}
