{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "schema",
    "tests",
    "seed.ts",
    "supatype.config.ts",
    "vite.config.ts",
    "supatype/generated"
  ]
}
