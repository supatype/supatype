POSTGRES_USER=supatype_admin
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=self_host_example
# PostgREST connects as the `authenticator` role and compose requires this,
# so leaving it out stops the stack before any container starts.
AUTHENTICATOR_PASSWORD=change-me-to-a-long-random-string

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Left blank on purpose: both are JWTs signed with JWT_SECRET above, so a
# value here would only be valid for the secret it was minted from.
# `supatype self-host compose up` mints them on first start and leaves any
# value you set alone.
ANON_KEY=
SERVICE_ROLE_KEY=

API_EXTERNAL_URL=http://localhost:18473
SITE_URL=http://localhost:3000

SUPATYPE_MAILER_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# Optional: override Compose image tags (defaults use :latest on Docker Hub).
# SUPATYPE_POSTGRES_IMAGE=supatype/postgres:17-latest
# SUPATYPE_SERVER_IMAGE=supatype/server:latest
# SUPATYPE_STORAGE_IMAGE=supatype/storage:latest
# SUPATYPE_FUNCTIONS_WORKER_IMAGE=supatype/functions-worker:latest
# SUPATYPE_CONTROL_PLANE_IMAGE=supatype/control-plane:latest
# SUPATYPE_STUDIO_IMAGE=supatype/studio:latest
# SUPATYPE_ENGINE_IMAGE=supatype/schema-engine:latest
