# Copy to .env then run: pnpm keys && pnpm push && pnpm dev
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# These two must match: POSTGRES_PASSWORD initialises the database, DATABASE_URL is what
# tools connect with.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The image's first start checks the database as supatype_admin, so that is the user, as every
# other example and `supatype init` have it. `postgres` here left the db container exiting with
# "password authentication failed for user supatype_admin".
POSTGRES_USER=supatype_admin
POSTGRES_DB=edge-kit
DATABASE_URL=postgresql://supatype_admin:change-me-to-a-long-random-string@127.0.0.1:5432/edge-kit

# Filled by `supatype keys` / `supatype dev`
ANON_KEY=
SERVICE_ROLE_KEY=
PUBLIC_SUPATYPE_URL=http://localhost:18473
VITE_SUPATYPE_URL=http://localhost:18473
VITE_SUPATYPE_ANON_KEY=
