# Copy to .env.local. Next.js reads this directory, not the project root, and the CLI only ever
# writes VITE_/PUBLIC_/EXPO_PUBLIC_ names, so the anon key has to be pasted here by hand.
# Take it from the project root .env after `pnpm keys`.
NEXT_PUBLIC_SUPATYPE_URL=http://localhost:18475
NEXT_PUBLIC_SUPATYPE_ANON_KEY=paste-ANON_KEY-from-../../.env
SUPATYPE_AUTH_COOKIE_PREFIX=st
