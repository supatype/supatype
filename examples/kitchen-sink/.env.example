# Copy to .env, then: pnpm keys && pnpm build:app && pnpm dev
#
# `supatype keys` mints ANON_KEY and SERVICE_ROLE_KEY from JWT_SECRET and writes them back
# into this file. It cannot invent a JWT_SECRET, so one has to be here before it runs.
JWT_SECRET=kitchen-sink-dev-secret-at-least-32-characters-long

# These two must match: POSTGRES_PASSWORD initialises the database, DATABASE_URL is what
# tools connect with.
#
# The host port is 5440 rather than 5432 on purpose. 5432 is the first thing anything else
# Postgres-shaped takes: a system install, another stack, or an SSH tunnel forwarding a remote
# database. When that happens the seed connects to *that* server and fails with `password
# authentication failed`, which reads as a wrong password rather than a wrong server.
SUPATYPE_DB_PORT=5440
POSTGRES_PASSWORD=kitchen-sink-dev-postgres-password
# PostgREST's own login, deliberately not the same as POSTGRES_PASSWORD: rotating the
# operator's database password must not take the REST API down. `supatype dev` seeds this
# when it is missing; the compose file requires it, so a stack started any other way needs
# it here.
AUTHENTICATOR_PASSWORD=authenticator-local
POSTGRES_USER=supatype_admin
POSTGRES_DB=kitchen-sink
DATABASE_URL=postgresql://supatype_admin:kitchen-sink-dev-postgres-password@127.0.0.1:5440/kitchen-sink

# The gateway, which is what a browser talks to. `server.port` in supatype.config.ts is the
# internal server port and is not this. Pinned so the example's URLs are true; `supatype dev`
# otherwise picks the first free port from 18473 and writes its choice back here.
SUPATYPE_KONG_PORT=18475

# The SPA is served from the gateway origin too, so the app and the API share one host and there
# is no CORS to configure.
PUBLIC_SUPATYPE_URL=http://localhost:18475

# Filled by `supatype keys` / `supatype dev`, leave empty.
ANON_KEY=
SERVICE_ROLE_KEY=
VITE_SUPATYPE_URL=http://localhost:18475
VITE_SUPATYPE_ANON_KEY=

# Created on first `supatype dev` when both are set. Leaving them out is not an error; the stack
# starts and says no admin exists, and `supatype admin create-user` is the other way in.
SUPATYPE_ADMIN_EMAIL=admin@kitchen-sink.test
SUPATYPE_ADMIN_PASSWORD=
