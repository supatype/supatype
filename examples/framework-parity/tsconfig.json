{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "schema",
    "src/client.ts",
    "supatype.config.ts",
    "supatype/generated",
    "vite.*.config.ts",
    "vite.shared.ts"
  ],
  "exclude": [
    "functions"
  ]
}
