{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "svelte"]
  },
  "include": ["src/svelte/**/*.ts", "src/svelte/**/*.svelte", "src/client.ts", "supatype/generated"]
}
