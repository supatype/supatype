# Copy to `.env`, then from this directory:
#   pnpm exec supatype keys
#   pnpm exec supatype dev      (pushes the schema itself)
#
# `supatype dev` and `supatype keys` also sync EXPO_PUBLIC_* for the Expo app.

# `supatype dev` publishes Postgres on SUPATYPE_DEV_DB_PORT (54329 unless taken) and keeps this
# URL's port in step with it. The password is POSTGRES_PASSWORD's.
DATABASE_URL=postgresql://supatype_admin:change-me-to-a-long-random-string@127.0.0.1:54329/expo-auth
POSTGRES_USER=supatype_admin
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=expo-auth

# JWT: run `supatype keys` (or start `supatype dev`) to mint ANON_KEY / SERVICE_ROLE_KEY
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ANON_KEY=
SERVICE_ROLE_KEY=

# Local API gateway (Kong). Change SUPATYPE_KONG_PORT if 18473 is taken.
SUPATYPE_KONG_PORT=18473
PUBLIC_SUPATYPE_URL=http://localhost:18473
API_EXTERNAL_URL=http://localhost:18473
SITE_URL=supatype-expo-auth://

# Expo app (read by Metro via EXPO_PUBLIC_*)
EXPO_PUBLIC_SUPATYPE_URL=http://localhost:18473
EXPO_PUBLIC_SUPATYPE_ANON_KEY=

# Email redirects and magic links: the console provider logs them to the server
SUPATYPE_MAILER_AUTOCONFIRM=true
